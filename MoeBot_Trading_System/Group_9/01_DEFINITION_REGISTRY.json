  "setup_families": {
    "G9_ICT_LIQUIDITY_DELIVERY": {
      "school_scope": "ict_smc",
      "root_subject_type": "school_interpretation",
      "root_definitions": ["ict_liquidity_sweep_displacement"],
      "root_role": "liquidity+displacement",
      "direction_rule": "use root stored direction; must be bullish or bearish",
      "forming_rule": "emit FORMING when one qualifying root becomes causally available",
      "ready_requirements": [
        {"role":"structure+confirmation","subject_type":"school_interpretation","one_of":["ict_mss_fvg_delivery"],"direction":"same_as_root"},
        {"role":"poi_or_retracement","subject_type":"school_interpretation","one_of":["ict_return_to_imbalance","ict_block_delivery_context"],"direction":"same_as_root_or_neutral"}
      ],
      "optional_support": ["ict_premium_discount_context","ict_draw_on_liquidity_context"],
      "ready_rule": "earliest causal point when every ready requirement has linked evidence and no authoritative invalidation is already available"
    },
    "G9_WYCKOFF_RANGE_RESOLUTION": {
      "school_scope": "wyckoff",
      "root_subject_type": "school_interpretation",
      "root_definitions": ["wyckoff_spring_candidate","wyckoff_upthrust_candidate"],
      "root_role": "liquidity",
      "direction_rule": "spring=>bullish; upthrust=>bearish; must agree with stored root direction",
      "forming_rule": "emit FORMING when one qualifying root becomes causally available",
      "ready_requirements": [
        {"role":"context","subject_type":"school_interpretation","one_of":["wyckoff_range_context"],"direction":"neutral_allowed"},
        {"role":"displacement+structure","subject_type":"school_interpretation","by_root":{"wyckoff_spring_candidate":["wyckoff_sign_of_strength"],"wyckoff_upthrust_candidate":["wyckoff_sign_of_weakness"]},"direction":"same_as_root"},
        {"role":"retracement+confirmation","subject_type":"school_interpretation","by_root":{"wyckoff_spring_candidate":["wyckoff_last_point_of_support"],"wyckoff_upthrust_candidate":["wyckoff_last_point_of_supply"]},"direction":"same_as_root"}
      ],
      "optional_support": [],
      "ready_rule": "earliest causal point when the root's exact range chain reaches its matching sign and last-point interpretation without prior authoritative invalidation"
    },
    "G9_STRUCTURAL_PULLBACK_CONTINUATION": {
      "school_scope": "classical_price_action+dow_theory",
      "root_subject_type": "narrative_hypothesis",
      "root_definitions": ["pa_structural_pullback"],
      "root_role": "retracement+structure",
      "direction_rule": "use root stored direction; must be bullish or bearish",
      "forming_rule": "emit FORMING when one qualifying structural-pullback hypothesis becomes causally available",
      "ready_requirements": [
        {"role":"structure_context","subject_type":"school_interpretation","one_of":["dow_advancing_structure","dow_declining_structure","dow_protected_pullback"],"direction":"same_as_root"},
        {"role":"confirmation","subject_type":"narrative_hypothesis","one_of":["pa_continuation_after_pullback"],"direction":"same_as_root"}
      ],
      "optional_support": ["ict_return_to_imbalance","ict_block_delivery_context"],
      "ready_rule": "earliest causal point when linked same-direction structure context and the first qualifying continuation hypothesis are both available without prior authoritative invalidation"
    }
  },
  "terminal_rules": {
    "FAILED": "FORMING setup receives authoritative Group 8 invalidation against its root or mandatory linked evidence before READY",
    "INVALIDATED": "READY setup later receives authoritative Group 8 invalidation against its root or mandatory linked evidence",
    "MISSING": "at the frozen dataset censor boundary, setup remains FORMING and at least one mandatory READY component never became causally available; MISSING is not emitted before the censor boundary"
